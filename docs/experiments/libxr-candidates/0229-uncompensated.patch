@@ -284,6 +282,36 @@
   * clock settings keep the generic path. Validate the pad with RMT. */
  #undef PIN_DELAY
  #define PIN_DELAY() PIN_DELAY_SLOW(7U)
+ /* LibXR-inspired byte unrolling and word-level parity folding. Only this
+  * existing 4 MHz path changes; WAIT/FAULT, turnaround, data-phase handling,
+  * timestamps and idle cycles still come from the shared transfer function.
+  * See docs/libxr-swd-review.md for the pinned upstream source and license. */
+ static inline uint32_t SWD_Parity32(uint32_t value) {
+   value^=value>>16;value^=value>>8;value^=value>>4;
+   return (0x6996U>>(value&15U))&1U;
+ }
+ #undef SW_READ_DATA32
+ #define SW_READ_DATA32() do {                                                 \
+   val=0U;                                                                   \
+   for(n=0;n<4;n++) {                                                        \
+     uint32_t octet;                                                         \
+     SW_READ_BIT(bit);octet=bit;                                             \
+     SW_READ_BIT(bit);octet|=bit<<1;                                         \
+     SW_READ_BIT(bit);octet|=bit<<2;                                         \
+     SW_READ_BIT(bit);octet|=bit<<3;                                         \
+     SW_READ_BIT(bit);octet|=bit<<4;                                         \
+     SW_READ_BIT(bit);octet|=bit<<5;                                         \
+     SW_READ_BIT(bit);octet|=bit<<6;                                         \
+     SW_READ_BIT(bit);octet|=bit<<7;                                         \
+     val=(val>>8)|(octet<<24);                                                \
+   }                                                                         \
+   parity=SWD_Parity32(val);                                                  \
+ } while(0)
+ #undef SW_WRITE_DATA32
+ #define SW_WRITE_DATA32() do {                                                \
+   val=*data;parity=SWD_Parity32(val);                                         \
+   for(n=32U;n;n--) {SW_WRITE_BIT(val);val>>=1;}                               \
+ } while(0)
