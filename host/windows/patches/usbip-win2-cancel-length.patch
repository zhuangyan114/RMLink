diff --git a/drivers/ude/request_list.cpp b/drivers/ude/request_list.cpp
--- a/drivers/ude/request_list.cpp
+++ b/drivers/ude/request_list.cpp
@@ -9,6 +9,7 @@
 #include "context.h"
 #include "wsk_context.h"
