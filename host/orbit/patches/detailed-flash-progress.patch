diff --git a/src/ozone-backend/rmlink-flash-progress.ts b/src/ozone-backend/rmlink-flash-progress.ts
new file mode 100644
--- /dev/null
+++ b/src/ozone-backend/rmlink-flash-progress.ts
@@ -0,0 +1,105 @@
+import type { FlashSector } from './cmsis-dap-flasher';
+
+interface FlashProgress {
+  phase?: string;
+  source?: string;
+  backend?: string;
+  verified?: boolean;
+  erased_pages?: number;
+  programmed_bytes?: number;
+  probe_received_bytes?: number;
+  probe_verified_bytes?: number;
+  probe_error_address?: number;
+  erase_strategy?: string;
+  error?: string;
+  host_elapsed_ms?: number;
+  probe_stage_us?: Record<string, number>;
+  timings?: Record<string, number>;
+}
+
+function address(value: number): string {
+  return `0x${value.toString(16).toUpperCase().padStart(8, '0')}`;
+}
+
+function duration(milliseconds: number | undefined): string {
+  return milliseconds !== undefined && Number.isFinite(milliseconds)
+    ? `，用时 ${(milliseconds / 1000).toFixed(3)}s`
+    : '';
+}
+
+/** Formats cached service snapshots. Only the verified COMMIT result completes a job. */
+export function createRMLinkFlashProgressReporter(
+  start: number,
+  size: number,
+  sectors: FlashSector[],
+  emit: (message: string) => void,
+): (snapshot: Record<string, unknown>) => void {
+  const range = `${address(start)} 至 ${address(start + size - 1)}`;
+  let previousMessage = '';
+  let finished = false;
+  emit(`准备烧录 ${range}，共 ${size} 字节、${sectors.length} 个扇区`);
+
+  return snapshot => {
+    if (finished) return;
+    const progress = snapshot as FlashProgress;
+    const erased = Math.min(sectors.length, Math.max(0, progress.erased_pages ?? 0));
+    const programmed = Math.min(size, Math.max(0, progress.programmed_bytes ?? 0));
+    if (progress.phase === 'complete' && progress.verified === true && progress.source !== 'status') {
+      finished = true;
+      const stages = progress.probe_stage_us;
+      const stageDuration = (name: string) => duration(stages?.[name] === undefined ? undefined : stages[name] / 1000);
+      if (progress.backend === 'probe') emit(`已上传 ${size} 字节至 RMLink${duration(progress.timings?.probe_upload_ms)}`);
+      if (stages?.preflight !== undefined) emit(`目标预检查完成${stageDuration('preflight')}`);
+      if (stages?.loader !== undefined) emit(`烧录算法加载与初始化完成${stageDuration('loader')}`);
+      emit(`已擦除 ${range}，共 ${sectors.length} 个扇区${stageDuration('erase')}`);
+      emit(`已写入 ${range}，共 ${size} 字节${stageDuration('program')}`);
+      emit(`已校验 ${range}，${size} 字节全部通过${stageDuration('full_verify')}`);
+      if (progress.timings?.host_finalize_ms !== undefined) {
+        emit(`主机收尾完成${duration(progress.timings.host_finalize_ms)}`);
+      }
+      emit(`烧录完成 ${range}${duration(progress.timings?.enhanced_total_ms ?? progress.host_elapsed_ms)}（总计）`);
+      return;
+    }
+    if (progress.phase === 'failed' || progress.phase === 'cancelled') {
+      finished = true;
+      const fault = progress.probe_error_address ? `，失败地址 ${address(progress.probe_error_address)}` : '';
+      emit(`烧录${progress.phase === 'cancelled' ? '已取消' : '失败'}，已擦除 ${erased}/${sectors.length} 个扇区，已写入 ${programmed}/${size} 字节${fault}${duration(progress.host_elapsed_ms)}${progress.error ? `，${progress.error}` : ''}`);
+      return;
+    }
+
+    let message: string;
+    switch (progress.phase) {
+      case 'staging': message = `准备镜像中... ${range}`; break;
+      case 'staged': message = `镜像已提交至连接服务${duration(progress.host_elapsed_ms)}`; break;
+      case 'upload_probe': {
+        const percent = Math.floor((progress.probe_received_bytes ?? 0) * 10 / size) * 10;
+        message = `上传至 RMLink 中... ${range}，${percent}%`;
+        break;
+      }
+      case 'probe_ready': message = `RMLink 镜像缓存已就绪，共 ${size} 字节`; break;
+      case 'preflight': message = '目标预检查中...'; break;
+      case 'load_algorithm': message = '烧录算法加载与初始化中...'; break;
+      case 'erase': {
+        const sector = progress.erase_strategy === 'mass' ? undefined : sectors[erased];
+        const current = sector ? `${address(sector.address)} 至 ${address(sector.address + sector.size - 1)}` : range;
+        message = `擦除中... ${current}，已擦除 ${erased}/${sectors.length} 个扇区`;
+        break;
+      }
+      case 'program':
+      case 'verify_page': {
+        const percent = Math.floor(programmed * 10 / size) * 10;
+        message = `写入中... ${range}，${percent}%`;
+        break;
+      }
+      case 'verify':
+      case 'verify_probe': message = `全镜像校验中... ${range}`; break;
+      case 'verify_host': message = `主机独立校验中... ${range}`; break;
+      case 'reset':
+      case 'probe_complete': message = '烧录收尾中...'; break;
+      case 'progress_unavailable': message = `进度查询失败，等待烧录请求返回，${progress.error}`; break;
+      default: return;
+    }
+    if (message !== previousMessage) emit(message);
+    previousMessage = message;
+  };
+}
diff --git a/src/ozone-backend/rmlink-flash-progress.test.ts b/src/ozone-backend/rmlink-flash-progress.test.ts
new file mode 100644
--- /dev/null
+++ b/src/ozone-backend/rmlink-flash-progress.test.ts
@@ -0,0 +1,52 @@
+import { describe, expect, it } from 'vitest';
+import { createRMLinkFlashProgressReporter } from './rmlink-flash-progress';
+
+const sectors = [0, 1, 2, 3, 4].map(number => ({
+  number,
+  address: 0x08000000 + number * 16384,
+  size: number === 4 ? 65536 : 16384,
+}));
+
+describe('RMLink Flash progress', () => {
+  it('shows live sector ranges and measured completion timings without duplicate snapshots', () => {
+    const messages: string[] = [];
+    const report = createRMLinkFlashProgressReporter(0x08000000, 131072, sectors, message => messages.push(message));
+    report({ phase: 'erase', erased_pages: 0 });
+    report({ phase: 'erase', erased_pages: 0 });
+    report({ phase: 'program', erased_pages: 1, programmed_bytes: 0 });
+    report({ phase: 'erase', erased_pages: 4, programmed_bytes: 65536 });
+    report({ phase: 'verify_probe', programmed_bytes: 131072 });
+    report({ phase: 'complete', verified: true, source: 'status' });
+    expect(messages.some(message => message.startsWith('烧录完成'))).toBe(false);
+    report({
+      phase: 'complete', verified: true, source: 'result', backend: 'probe',
+      probe_stage_us: { preflight: 5407, loader: 12132, erase: 1329473, program: 1495404, full_verify: 717199 },
+      timings: { probe_upload_ms: 697.838, host_finalize_ms: 15.033, enhanced_total_ms: 4533.604 },
+    });
+    report({ phase: 'erase', erased_pages: 0 });
+    expect(messages.filter(message => message === '擦除中... 0x08000000 至 0x08003FFF，已擦除 0/5 个扇区')).toHaveLength(1);
+    expect(messages).toContain('擦除中... 0x08010000 至 0x0801FFFF，已擦除 4/5 个扇区');
+    expect(messages).toContain('已擦除 0x08000000 至 0x0801FFFF，共 5 个扇区，用时 1.329s');
+    expect(messages).toContain('已写入 0x08000000 至 0x0801FFFF，共 131072 字节，用时 1.495s');
+    expect(messages).toContain('已校验 0x08000000 至 0x0801FFFF，131072 字节全部通过，用时 0.717s');
+    expect(messages.at(-1)).toBe('烧录完成 0x08000000 至 0x0801FFFF，用时 4.534s（总计）');
+  });
+
+  it('retains partial failure details and never completes an unverified image', () => {
+    const messages: string[] = [];
+    const report = createRMLinkFlashProgressReporter(0x08000000, 131072, sectors, message => messages.push(message));
+    report({ phase: 'complete', verified: false });
+    report({ phase: 'failed', erased_pages: 2, programmed_bytes: 16384, probe_error_address: 0x08004000, error: 'FlashFailed', host_elapsed_ms: 1140 });
+    report({ phase: 'complete', verified: true });
+    expect(messages.at(-1)).toContain('烧录失败，已擦除 2/5 个扇区，已写入 16384/131072 字节，失败地址 0x08004000，用时 1.140s');
+    expect(messages.some(message => message.startsWith('已校验') || message.startsWith('烧录完成'))).toBe(false);
+  });
+
+  it('keeps sparse jobs separate and accepts older results without fabricated timings', () => {
+    const messages: string[] = [];
+    const report = createRMLinkFlashProgressReporter(0x08010000, 65536, [sectors[4]], message => messages.push(message));
+    report({ phase: 'complete', verified: true });
+    expect(messages).toContain('已擦除 0x08010000 至 0x0801FFFF，共 1 个扇区');
+    expect(messages.join('\n')).not.toMatch(/0x08000000|NaN|用时/);
+  });
+});
