# RMLink V1, verified against JLCEDA schematic and PCB on 2026-11-09.
CONFIG_DEBUG_PROBE_GPIO_TMS=17
CONFIG_DEBUG_PROBE_GPIO_TCK=18
CONFIG_DEBUG_PROBE_GPIO_TDI=8
CONFIG_DEBUG_PROBE_GPIO_TDO=7
CONFIG_RMLINK_NRST_GPIO=6
# CONFIG_RMLINK_OTA_BOARD_V1_MIGRATION is not set
# CONFIG_RMLINK_LEDS_ENABLED is not set
CONFIG_RMLINK_UI_ENABLED=y
CONFIG_RMLINK_UI_LED_GPIO=1
CONFIG_RMLINK_UI_KEY_GPIO=2
CONFIG_RMLINK_UI_BRIGHTNESS=32
# CONFIG_RMLINK_TARGET_UART_ENABLED is not set
# CONFIG_RMLINK_MSC_ENABLED is not set
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
