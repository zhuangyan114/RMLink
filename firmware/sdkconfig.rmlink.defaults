CONFIG_DEBUG_PROBE_IFACE_SWD=y
CONFIG_DEBUG_PROBE_GPIO_TMS=4
CONFIG_DEBUG_PROBE_GPIO_TCK=5
CONFIG_RMLINK_NRST_GPIO=6
# CONFIG_RMLINK_TARGET_PINS_CONFIRMED is not set
# CONFIG_RMLINK_LEDS_ENABLED is not set
# CONFIG_RMLINK_TARGET_UART_ENABLED is not set
# CONFIG_RMLINK_MSC_ENABLED is not set
CONFIG_BRIDGE_MANUFACTURER="RMLink development"
CONFIG_BRIDGE_PRODUCT_NAME="RMLink CMSIS-DAP"
CONFIG_BRIDGE_DOWNLOAD_MAGIC_BAUD=0
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# CONFIG_SPIRAM is not set
CONFIG_RMLINK_WIFI_ENABLED=y
CONFIG_RMLINK_TCP_PORT=3241
