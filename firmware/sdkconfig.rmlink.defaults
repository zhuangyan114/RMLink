CONFIG_DEBUG_PROBE_IFACE_SWD=y
CONFIG_DEBUG_PROBE_GPIO_TMS=4
CONFIG_DEBUG_PROBE_GPIO_TCK=5
CONFIG_RMLINK_NRST_GPIO=6
# CONFIG_RMLINK_TARGET_PINS_CONFIRMED is not set
# CONFIG_RMLINK_LEDS_ENABLED is not set
# CONFIG_RMLINK_TARGET_UART_ENABLED is not set
# CONFIG_RMLINK_MSC_ENABLED is not set
CONFIG_BRIDGE_MANUFACTURER="RMLink development"
CONFIG_BRIDGE_PRODUCT_NAME="RMLink CMSIS-DAP"
CONFIG_BRIDGE_DOWNLOAD_MAGIC_BAUD=0
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# CONFIG_SPIRAM is not set
CONFIG_RMLINK_WIFI_ENABLED=y
CONFIG_RMLINK_TCP_PORT=3241
# Fine TCP ticks and a 300 ms initial RTO recover individual losses without
# waiting 1.5 s or depending on a multi-second sample buffer.
CONFIG_LWIP_TCP_TMR_INTERVAL=50
CONFIG_LWIP_TCP_RTO_TIME=300
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5744
# Bound radio queue memory too when all networking uses internal RAM.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
# Raw LwIP mDNS queues hold zero-copy Wi-Fi dynamic RX buffers until drained.
# Keep mDNS off the SWD executor core and strictly smaller than the RX pool.
CONFIG_MDNS_TASK_PRIORITY=4
CONFIG_MDNS_ACTION_QUEUE_LEN=8
CONFIG_MDNS_TASK_AFFINITY_NO_AFFINITY=y
# CONFIG_MDNS_TASK_AFFINITY_CPU0 is not set
